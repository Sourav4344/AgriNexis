# CLIENT-SAFE
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# SERVER ONLY: never expose through NEXT_PUBLIC_ or bundle into Flutter
SUPABASE_SECRET_KEY=your_server_secret_key
# SERVER ONLY: legacy compatibility only; prefer SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
DATABASE_URL=postgresql://user:password@host:5432/database

API_BASE_URL=http://localhost:8000/api/v1
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
APP_ENV=development
LOG_LEVEL=INFO

FCM_PROJECT_ID=your_firebase_project_id
# SERVER ONLY
FCM_SERVER_CREDENTIALS_JSON=server_only_path_or_secret_reference

DEMO_MODE=true
MARKET_DATA_PROVIDER=demo
MAP_PROVIDER=osm
