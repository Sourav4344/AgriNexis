# ==============================================================================
# AgriNexis Environment Configuration Template (.env.example)
# Problem Statement: SIH 2026 PS-26132 (Gov of Maharashtra)
# ==============================================================================
# SECURITY NOTICE:
# - Commit ONLY .env.example with sanitized placeholder values.
# - NEVER commit real secrets, private keys, service-role tokens, or passwords.
# - Variables prefixed with NEXT_PUBLIC_ are visible to browser clients.
# - Server secrets (DATABASE_URL, SUPABASE_SECRET_KEY, FCM credentials) must NEVER
#   be prefixed with NEXT_PUBLIC_ or compiled into Flutter/client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & RUNTIME MODE
# ------------------------------------------------------------------------------
# Options: development | test | demo | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Master Demo Mode Flag (Explicit: LIVE failure never silently falls back to DEMO)
# Set to 'true' for SIH Hackathon presentations and offline rehearsals.
# Set to 'false' for live production operation.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. FASTAPI CORE SERVICE (services/api)
# ------------------------------------------------------------------------------
# Port 8000 by default
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000/api/v1

# Allowed CORS Origins (Comma-separated)
# Buyer Web is on :3001, Admin Web is on :3002, Development devserver on :3000
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Storage bucket name for produce quality inspection assets (private bucket)
STORAGE_BUCKET=produce-quality-images

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for local development or Docker Compose
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: In production or shared environments, do NOT use default 'postgres:postgres'.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD:-change_me_in_prod}@localhost:5432/agrinexis

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTH & VERIFICATION (Server & Client Boundaries)
# ------------------------------------------------------------------------------
# Client-Safe: Project reference URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Client-Safe: Public anonymous/publishable key used by frontend clients
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# SERVER-ONLY: Supabase secret key (or legacy service_role key)
# Used ONLY by trusted backend services for privileged operations.
# NEVER expose to browsers, Flutter, or logs.
SUPABASE_SECRET_KEY=your_server_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here

# JWT Verification: defaults derived from SUPABASE_URL if omitted:
# - SUPABASE_JWT_ISSUER = ${SUPABASE_URL}/auth/v1
# - SUPABASE_JWKS_URL = ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_SECONDS=300

# ------------------------------------------------------------------------------
# 5. MARKET DATA ENGINE (services/market-engine)
# ------------------------------------------------------------------------------
# Provider: 'demo' for SIH presentation fixtures, 'live' for real mandi feeds
MARKET_DATA_PROVIDER=demo
MARKET_LIVE_MAX_AGE_MINUTES=180
MARKET_CACHE_MAX_AGE_HOURS=48
MARKET_SOURCE_TIMEZONE=Asia/Kolkata
# Safe default: false (LIVE failures never silently fall back to DEMO unless explicitly forced)
MARKET_DEMO_FALLBACK_ENABLED=false

# ------------------------------------------------------------------------------
# 6. LOGISTICS & INTELLIGENCE ENGINES (services/logistics-engine)
# ------------------------------------------------------------------------------
# NOTE: No active OSRM, OSM, or Haversine live routing provider is approved or integrated.
# Current SIH demo logistics uses deterministic configured lane tariffs.
# Missing/unconfigured LIVE routing evidence returns UNAVAILABLE (HTTP 503).
# Do not configure commercial or live map routing without approved adapters.

# ------------------------------------------------------------------------------
# 7. BUYER WEB DASHBOARD (apps/buyer-web — Next.js 14, Port 3001)
# ------------------------------------------------------------------------------
# Must be prefixed with NEXT_PUBLIC_ to be exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Safe default: false
NEXT_PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 8. ADMIN WEB DASHBOARD (apps/admin-web — Next.js 15, Port 3002)
# ------------------------------------------------------------------------------
# Must be prefixed with NEXT_PUBLIC_ to be exposed to the browser
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8000/api/v1
# Safe default: false
NEXT_PUBLIC_ADMIN_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 9. FARMER MOBILE APP (apps/farmer-app — Flutter)
# ------------------------------------------------------------------------------
# Flutter compile-time definitions passed via `--dart-define`:
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1 --dart-define=AGRINEXIS_DEMO_MODE=true
# (Note: Use 10.0.2.2 for Android emulator to access host localhost; 127.0.0.1 for desktop/web)

# ------------------------------------------------------------------------------
# 10. EXTERNAL INTEGRATION STATUS DISCLOSURE
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM):
# NOT INTEGRATED — No active FCM adapter in current runtime. Push notifications require approved gateway adapter.
FCM_PROJECT_ID=
FCM_SERVER_CREDENTIALS_JSON=

# Payment Gateway:
# NOT INTEGRATED — No external payment gateway (Razorpay/Cashfree) adapter in current runtime.
# Payment operations strictly enforce the 5-state machine: PENDING -> PROCESSING -> PAID / FAILED / REFUNDED.
# Absolutely NO escrow lifecycle or intermediary fund-holding exists.
PAYMENT_PROVIDER=

# AGMARKNET Mandi Feeds:
# NOT INTEGRATED for automated live scraping in production runtime. Requires official API credentials.
