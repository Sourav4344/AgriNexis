# Trusted server-side connection. Never expose it to browser or Flutter builds.
DATABASE_URL=postgresql://user:password@host:5432/database

# No provider is bundled. Set only when a real adapter is installed and injected.
MARKET_DATA_PROVIDER=
MARKET_LIVE_MAX_AGE_MINUTES=180
MARKET_CACHE_MAX_AGE_HOURS=48
MARKET_SOURCE_TIMEZONE=Asia/Kolkata
MARKET_DEMO_FALLBACK_ENABLED=false
