# Server only; never expose to clients or logs.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_key
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DEMO_MODE=false
PAYMENT_PROVIDER=
